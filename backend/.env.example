# Backend Environment Configuration

NODE_ENV=development
PORT=5001
APP_NAME=FinGraph

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_TRANSACTIONS=fingraph-transactions
KAFKA_GROUP_ID=fingraph-stream-processor

# --- Neo4j Database ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fingraph123
NEO4J_DATABASE=neo4j

# --- Data Ingestion & Seed ---
DATA_PATH=./data/sample_transactions.csv
SEED_DATA=true

# --- Fraud Rules Thresholds ---
SMURFING_TRANSACTION_LIMIT=5
SMURFING_WINDOW_MINUTES=60
CIRCULAR_MAX_DEPTH=3
HIGH_FREQUENCY_COUNT=10
HIGH_FREQUENCY_WINDOW_MINUTES=15
LARGE_TRANSACTION_THRESHOLD=10000.0

# --- Frontend CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Email Alerts SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@fingraph.io
