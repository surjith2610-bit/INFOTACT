# Environment Configuration for FinGraph

# --- General & Backend ---
NODE_ENV=development
PORT=5000
APP_NAME=FinGraph

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_TRANSACTIONS=fingraph-transactions
KAFKA_GROUP_ID=fingraph-stream-processor

# --- Neo4j Graph Database ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fingraph123
NEO4J_DATABASE=neo4j

# --- Data Ingestion & Seed ---
DATA_PATH=./data/sample_transactions.csv
SEED_DATA=true

# --- Fraud Detection Thresholds ---
SMURFING_TRANSACTION_LIMIT=5
SMURFING_WINDOW_MINUTES=60
CIRCULAR_MAX_DEPTH=3
HIGH_FREQUENCY_COUNT=10
HIGH_FREQUENCY_WINDOW_MINUTES=15
LARGE_TRANSACTION_THRESHOLD=10000.0

# --- Authentication & CORS ---
JWT_SECRET=fingraph-super-secret-jwt-key-change-in-production
FRONTEND_ORIGIN=http://localhost:5173

# --- Real Email OTP (SMTP Configuration) ---
# For Gmail: Use smtp.gmail.com, Port 587, your Gmail address, and a 16-character Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=noreply@fingraph.io
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# --- Google OAuth Sign-In / Sign-Up ---
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized JavaScript origin: http://localhost:5173
# Authorized redirect URI: http://localhost:5000/auth/google-callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Frontend API Endpoint ---
VITE_API_URL=http://localhost:5000

